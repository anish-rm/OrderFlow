{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092,localhost:9093,localhost:9094",
    "EnableIdempotence": true,
    "MessageTimeoutMs": 10
  },
  "SchemaRegistry": {
    "Url": "http://localhost:8081"
  }
}
